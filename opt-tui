STAGE_LABEL = {"upload": "Enviando ao transcoder", "convert": "Convertendo (GPU)",
               "download": "Recebendo resultado"}
STAGE_RANGE = {"upload": (0.0, 0.2), "convert": (0.2, 0.8), "download": (0.8, 1.0)}


class RunScreen(Screen):
    BINDINGS = [
        Binding("c", "cancel", "Cancelar"),
        Binding("escape,enter", "back", "Voltar"),
    ]

    DEFAULT_CSS = """
    RunScreen Vertical#box { padding: 0 1; height: auto; }
    RunScreen .lbl { color: $text-muted; margin-top: 1; }
    RunScreen #current { text-style: bold; }
    RunScreen DataTable { height: 1fr; margin-top: 1; }
    """

    def __init__(self, paths: list[str], videos: bool, images: bool,
                 copy_mode: bool, force: bool):
        super().__init__()
        self.paths = paths
        self.videos = videos
        self.images = images
        self.copy_mode = copy_mode
        self.force = force
        self.proc: asyncio.subprocess.Process | None = None
        self.cancelled = False
        self.finished = False
        self.started = time.time()
        self.ok = self.skipped = self.failed = 0
        self.saved = 0
        self.base = (0, 0, 0, 0)
        self.row_n = 0
        self.step_label = ""
        self.stage_frac = 0.0

    def compose(self) -> ComposeResult:
        yield Header()
        with Vertical(id="box"):
            yield Static("Preparando…", id="title")
            yield Static("Geral", classes="lbl")
            yield ProgressBar(total=100, show_eta=False, id="overall")
            yield Static("", id="stage", classes="lbl")
            yield ProgressBar(total=100, show_eta=False, id="stagebar")
            yield Static("", id="current")
            yield Static("", id="totals")
        yield DataTable(id="results", cursor_type="row", zebra_stripes=True)
        yield Footer()

    def on_mount(self) -> None:
        self.title = "opt · executando"
        table = self.query_one("#results", DataTable)
        table.add_columns("", "Arquivo", "Original", "Novo", "Economia", "Obs.")
        table.can_focus = False
        self.set_interval(1, self.tick)
        self.run_all()

    # -- helpers de UI -------------------------------------------------

    def tick(self) -> None:
        if not self.finished:
            self.update_totals()

    def update_totals(self) -> None:
        elapsed = hms(time.time() - self.started)
        self.query_one("#totals", Static).update(
            f"[green]✓ {self.ok}[/green]   [yellow]⊘ {self.skipped}[/yellow]   "
            f"[red]✗ {self.failed}[/red]   ·   economia [b]{human(self.saved)}[/b]   ·   {elapsed}"
        )

    def set_overall(self, frac: float) -> None:
        self.query_one("#overall", ProgressBar).update(total=1000, progress=int(frac * 1000))

    def set_stage(self, name: str, pct: int) -> None:
        self.query_one("#stage", Static).update(f"{self.step_label} · {STAGE_LABEL.get(name, name)}")
        self.query_one("#stagebar", ProgressBar).update(total=100, progress=pct)

    # -- motores -------------------------------------------------------

    @work(exclusive=True)
    async def run_all(self) -> None:
        steps: list[tuple[str, str, list[str]]] = []
        for label, wanted, engine in (("Vídeos", self.videos, "videoopt"),
                                      ("Imagens", self.images, "imgopt")):
            if not wanted:
                continue
            exe = find_engine(engine)
            if not exe:
                self.query_one("#title", Static).update(f"[red]{engine} não encontrado[/red]")
                self.notify(f"{engine} não encontrado no PATH.", severity="error")
                continue
            mode = ("optimized" if engine == "videoopt" else "parallel") if self.copy_mode else "replace"
            args = [exe, "--events", "--yes", "--mode", mode]
            if self.force:
                args.append("--force")
            steps.append((label, engine, args + self.paths))

        for index, (label, engine, argv) in enumerate(steps):
            if self.cancelled:
                break
            self.step_label = label
            self.base = (self.ok, self.skipped, self.failed, self.saved)
            self.row_n = 0
            self.query_one("#title", Static).update(
                f"[b]{label}[/b]  (etapa {index + 1}/{len(steps)})"
            )
            await self.run_engine(engine, argv)

        self.finished = True
        self.update_totals()
        self.set_overall(1.0 if not self.cancelled else 0)
        status = "[yellow]Cancelado.[/yellow]" if self.cancelled else "[green]Concluído.[/green]"
        self.query_one("#title", Static).update(f"{status}  Pressione Enter ou Esc para voltar.")
        self.query_one("#stage", Static).update("")
        self.title = "opt · concluído"
        self.app.history.refresh()

    async def run_engine(self, engine: str, argv: list[str]) -> None:
        try:
            self.proc = await asyncio.create_subprocess_exec(
                *argv,
                stdin=asyncio.subprocess.DEVNULL,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.DEVNULL,
                start_new_session=True,
                limit=1 << 20,
            )
        except OSError as exc:
            self.notify(f"Falha ao iniciar {engine}: {exc}", severity="error")
            return

        assert self.proc.stdout is not None
        total = 0
        while True:
            raw = await self.proc.stdout.readline()
            if not raw:
                break
            try:
                ev = json.loads(raw.decode("utf-8", "replace"))
            except json.JSONDecodeError:
                continue
            total = self.handle(engine, ev, total)
        rc = await self.proc.wait()
        if rc not in (0, 130) and not self.cancelled:
            self.notify(f"{engine} terminou com código {rc}", severity="warning")
        self.proc = None

    def handle(self, engine: str, ev: dict, total: int) -> int:
        kind = ev.get("ev")
        cur = self.query_one("#current", Static)

        if kind == "check":
            i, tot = int(ev.get("i", 0)), max(int(ev.get("total", 1)), 1)
            cur.update(f"Verificando {i}/{tot}  ·  {ev.get('name', '')}")
            self.query_one("#stage", Static).update(
                f"{self.step_label} · verificando histórico e eficiência"
            )
            self.query_one("#stagebar", ProgressBar).update(total=100, progress=int(i * 100 / tot))
        elif kind == "scan" and ev.get("phase") == "find":
            cur.update("Procurando imagens…")
        elif kind == "scan" and "todo" in ev:
            cur.update(
                f"{ev.get('todo', 0)} a processar · {ev.get('history', 0)} já otimizados "
                f"(histórico) · {ev.get('efficient', 0)} já eficientes"
            )
        elif kind == "start":
            total = int(ev.get("total", 0))
        elif kind == "file":
            total = int(ev.get("total", total))
            cur.update(f"{ev.get('i', '?')}/{total}  {ev.get('name', '')}  ({human(ev.get('size', 0))})")
            self.stage_frac = 0.0
            self.query_one("#stagebar", ProgressBar).update(total=100, progress=0)
        elif kind == "stage":
            name = ev.get("stage", "")
            pct = int(ev.get("pct", 0))
            self.set_stage(name, pct)
            lo, hi = STAGE_RANGE.get(name, (0, 1))
            self.stage_frac = lo + (hi - lo) * pct / 100
            if total:
                self.set_overall((self.row_n + self.stage_frac) / total)
        elif kind == "result":
            self.row_n += 1
            status = ev.get("status", "")
            table = self.query_one("#results", DataTable)
            symbol = {"ok": Text("✓", style="green"), "skip": Text("⊘", style="yellow"),
                      "fail": Text("✗", style="red")}.get(status, Text("?"))
            saved = int(ev.get("saved", 0))
            table.add_row(
                symbol, ev.get("name", ""), human(ev.get("orig", 0)),
                human(ev.get("new", 0)) if ev.get("new") else "–",
                human(saved) if saved else "–", ev.get("msg", ""),
            )
            table.move_cursor(row=table.row_count - 1)
            if status == "ok":
                self.ok += 1
                self.saved += saved
            elif status == "skip":
                self.skipped += 1
            elif status == "fail":
                self.failed += 1
            if total:
                self.set_overall(self.row_n / total)
            self.update_totals()
        elif kind == "progress":  # imgopt
            done, tot = int(ev.get("done", 0)), max(int(ev.get("total", 1)), 1)
            self.set_overall(done / tot)
            b_ok, b_skip, b_fail, b_saved = self.base
            self.ok = b_ok + int(ev.get("ok", 0))
            self.skipped = b_skip + int(ev.get("skipped", 0)) + int(ev.get("history", 0))
            self.failed = b_fail + int(ev.get("failed", 0))
            self.saved = b_saved + int(ev.get("saved", 0))
            reading = f"\nlendo: {ev['name']}" if ev.get("name") else ""
            cur.update(
                f"{done}/{tot} imagens · {ev.get('history', 0)} já otimizadas (histórico){reading}"
            )
            self.query_one("#stage", Static).update(f"{self.step_label} · processando em paralelo")
            self.query_one("#stagebar", ProgressBar).update(total=100, progress=int(done * 100 / tot))
            self.update_totals()
        elif kind == "error":
            self.notify(ev.get("msg", "erro"), severity="error", timeout=10)
            cur.update(f"[red]{ev.get('msg', 'erro')}[/red]")
        elif kind == "warn":
            self.notify(ev.get("msg", ""), severity="warning")
        elif kind == "end":
            self.update_totals()
        return total

    # -- ações ---------------------------------------------------------

    def action_cancel(self) -> None:
        if self.finished or self.cancelled:
            return
        self.cancelled = True
        self.query_one("#title", Static).update("[yellow]Cancelando e limpando o job remoto…[/yellow]")
        self.terminate()

    @work(exclusive=False)
    async def terminate(self) -> None:
        proc = self.proc
        if not proc:
            return
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            return
        try:
            await asyncio.wait_for(proc.wait(), timeout=20)
        except asyncio.TimeoutError:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass

    def action_back(self) -> None:
        if not self.finished:
            self.notify("Em execução. Use [b]c[/b] para cancelar.", severity="warning")
            return
        self.app.pop_screen()


