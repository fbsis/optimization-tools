class HistoryScreen(Screen):
    BINDINGS = [Binding("escape,q", "back", "Menu")]

    DEFAULT_CSS = """
    #hsummary { padding: 0 1; text-style: bold; }
    HistoryScreen DataTable { height: 1fr; }
    """

    def compose(self) -> ComposeResult:
        yield Header()
        yield Static(id="hsummary")
        yield DataTable(cursor_type="row", zebra_stripes=True)
        yield Footer()

    def on_mount(self) -> None:
        self.title = "opt · histórico"
        history: History = self.app.history
        history.refresh()
        entries = history.entries
        table = self.query_one(DataTable)
        table.add_columns("Data", "Tipo", "Status", "Original", "Novo", "Economia", "Ferramenta")
        for e in reversed(entries[-1000:]):
            saved = max(e.orig - e.new, 0) if e.status == "ok" else 0
            table.add_row(e.date.replace("T", " "), e.kind, e.status, human(e.orig),
                          human(e.new), human(saved) if saved else "–", e.tool)
        ok = [e for e in entries if e.status == "ok"]
        saved = sum(max(e.orig - e.new, 0) for e in ok)
        self.query_one("#hsummary", Static).update(
            f"{len(entries)} registros · {len(ok)} otimizados · economia total {human(saved)} · {HISTORY_FILE}"
        )

    def action_back(self) -> None:
        self.app.pop_screen()


