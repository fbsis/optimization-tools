class OptApp(App):
    TITLE = "opt"
    CSS = """
    #menu { width: 64; height: auto; margin: 2 4; border: round $primary; padding: 1 2; }
    #banner { padding: 1 4 0 4; text-style: bold; color: $accent; }
    #hint { padding: 0 4; color: $text-muted; }
    """
    BINDINGS = [Binding("ctrl+q", "quit", "Sair", show=False)]

    def __init__(self, start: Path):
        super().__init__()
        self.start = start
        self.history = History()
        self.history.refresh()
        self.scanner = Scanner(self.history)

    def compose(self) -> ComposeResult:
        yield Header()
        yield Static("OPT · otimização de mídia", id="banner")
        yield OptionList(
            Option("🎬  Navegar pastas e otimizar        [dim]vídeos + imagens[/dim]", id="browse"),
            Option(f"⚡  Otimizar a pasta atual            [dim]{self.start.name or '/'}[/dim]", id="here"),
            Option("🕘  Histórico                        [dim]o que já foi feito[/dim]", id="history"),
            Option("📦  Filler                           [dim]mover p/ VeraCrypt[/dim]", id="filler"),
            Option("✖   Sair", id="quit"),
            id="menu",
        )
        yield Static("↑↓ escolhe · Enter abre · q sai", id="hint")
        yield Footer()

    def on_mount(self) -> None:
        self.query_one(OptionList).focus()

    def on_key(self, event) -> None:
        if event.key == "q" and len(self.screen_stack) == 1:
            self.exit()

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        choice = event.option.id
        if choice == "browse":
            self.push_screen(BrowserScreen(self.start))
        elif choice == "here":
            text = (f"[b]Otimizar vídeos + imagens[/b]\nModo: SUBSTITUIR os originais\n\n"
                    f"  • {self.start}")

            def after(ok: bool | None) -> None:
                if ok:
                    self.push_screen(RunScreen([str(self.start)], True, True, False, False))

            self.push_screen(Confirm(text), after)
        elif choice == "history":
            self.push_screen(HistoryScreen())
        elif choice == "filler":
            self.run_filler(self.start)
        else:
            self.exit()

    def run_filler(self, folder: Path) -> None:
        exe = find_engine("filler")
        if not exe:
            self.notify("filler não encontrado no PATH.", severity="error")
            return
        with self.suspend():
            subprocess.run(["clear"], check=False)
            subprocess.run([exe], cwd=folder, check=False)
            try:
                input("\nEnter para voltar ao opt… ")
            except (EOFError, KeyboardInterrupt):
                pass


def main() -> int:
    start = Path(os.environ.get("OPT_TUI_CWD", os.getcwd())).resolve()
    if len(sys.argv) > 1 and Path(sys.argv[1]).is_dir():
        start = Path(sys.argv[1]).resolve()
    OptApp(start).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
