def pct(part: float, whole: float) -> str:
    return f"{part * 100 / whole:.0f}%" if whole else "–"


def saved_of(e: Entry) -> int:
    return max(e.orig - e.new, 0) if e.status == "ok" else 0


class StatsScreen(Screen):
    BINDINGS = [Binding("escape,q", "back", "Menu"), Binding("r", "reload", "Atualizar")]

    DEFAULT_CSS = """
    StatsScreen DataTable { height: 1fr; }
    StatsScreen VerticalScroll { padding: 1 2; }
    """

    def compose(self) -> ComposeResult:
        yield Header()
        with TabbedContent():
            with TabPane("Resumo"):
                with VerticalScroll():
                    yield Static(id="st_summary")
            with TabPane("Por tipo/formato"):
                yield DataTable(id="st_ext", cursor_type="row", zebra_stripes=True)
            with TabPane("Por dia"):
                yield DataTable(id="st_days", cursor_type="row", zebra_stripes=True)
            with TabPane("Sessões"):
                yield DataTable(id="st_sessions", cursor_type="row", zebra_stripes=True)
            with TabPane("Maiores economias"):
                yield DataTable(id="st_top", cursor_type="row", zebra_stripes=True)
        yield Footer()

    def on_mount(self) -> None:
        self.title = "opt · estatísticas"
        for tid, cols in (
            ("st_ext", ("Tipo", "Formato", "Otimizados", "Sem ganho", "Já eficientes",
                        "Original", "Novo", "Economia", "Redução", "Tempo médio")),
            ("st_days", ("Dia", "Otimizados", "Original", "Economia", "Redução", "Sessões", "Tempo")),
            ("st_sessions", ("Início/fim", "Ferramenta", "Modo", "Status", "Duração", "Achados",
                             "Já feitos", "Eficientes", "OK", "Sem ganho", "Erros", "Economia",
                             "Vazão", "Arq/h")),
            ("st_top", ("Economia", "Redução", "Original", "Tipo", "Arquivo")),
        ):
            self.query_one(f"#{tid}", DataTable).add_columns(*cols)
        self.action_reload()

    def action_back(self) -> None:
        self.app.pop_screen()

    def action_reload(self) -> None:
        history: History = self.app.history
        history.refresh()
        self.fill_summary(history)
        self.fill_formats(history.entries)
        self.fill_days(history)
        self.fill_sessions(history.sessions)
        self.fill_top(history.entries)

    # -- resumo --------------------------------------------------------

    def fill_summary(self, history: History) -> None:
        entries, sessions = history.entries, history.sessions
        ok = [e for e in entries if e.status == "ok"]
        skip = [e for e in entries if e.status == "skip-larger"]
        eff = [e for e in entries if e.status == "efficient"]
        orig = sum(e.orig for e in ok)
        new = sum(e.new for e in ok)
        saved = orig - new
        done = [s for s in sessions if s.status == "done"]
        total_secs = sum(s.seconds for s in sessions)
        proc_orig = sum(s.orig for s in sessions)
        failed = sum(s.failed for s in sessions)
        canceled = len([s for s in sessions if s.status == "canceled"])

        def period(days: int) -> str:
            cutoff = time.strftime("%Y-%m-%d", time.localtime(time.time() - days * 86400))
            sel = [e for e in ok if e.date[:10] >= cutoff]
            return f"{len(sel)} arquivos · {human(sum(saved_of(e) for e in sel))}"

        by_kind = []
        for kind, label in (("video", "Vídeos"), ("image", "Imagens")):
            k_ok = [e for e in ok if e.kind == kind]
            k_orig = sum(e.orig for e in k_ok)
            k_saved = sum(saved_of(e) for e in k_ok)
            by_kind.append(
                f"  {label:<8} {len(k_ok):>6} otimizados · economia {human(k_saved):>10} "
                f"({pct(k_saved, k_orig)})"
            )

        avg_secs = total_secs / len(sessions) if sessions else 0
        rate = proc_orig / total_secs * 3600 if total_secs else 0
        files_h = sum(s.ok for s in sessions) / total_secs * 3600 if total_secs else 0
        text = (
            f"[b]Arquivos[/b]\\n"
            f"  Registrados:        {len(entries)}\\n"
            f"  [green]Otimizados:[/green]         {len(ok)}   (taxa de sucesso {pct(len(ok), len(ok) + len(skip))})\\n"
            f"  [yellow]Sem ganho:[/yellow]          {len(skip)}   (conversão não reduziu o tamanho)\\n"
            f"  Já eficientes:      {len(eff)}   (pulados pelo ffprobe)\\n"
            f"  Erros (sessões):    {failed}\\n\\n"
            f"[b]Espaço[/b]\\n"
            f"  Original → novo:    {human(orig)} → {human(new)}\\n"
            f"  [b]Economia total:     {human(saved)}[/b]  ({pct(saved, orig)} de redução)\\n"
            f"  Média por arquivo:  {human(saved / len(ok)) if ok else '–'}\\n\\n"
            f"[b]Por tipo[/b]\\n" + "\\n".join(by_kind) + "\\n\\n"
            f"[b]Período[/b]\\n"
            f"  Hoje:               {period(0)}\\n"
            f"  Últimos 7 dias:     {period(7)}\\n"
            f"  Últimos 30 dias:    {period(30)}\\n\\n"
            f"[b]Sessões[/b]\\n"
            f"  Execuções:          {len(sessions)}   ({len(done)} concluídas, {canceled} canceladas)\\n"
            f"  Tempo total:        {hms(total_secs)}   (média {hms(avg_secs)} por sessão)\\n"
            f"  Vazão média:        {human(rate)}/h de originais · {files_h:.0f} arquivos/h\\n\\n"
            f"[dim]{HISTORY_FILE}\\n{SESSIONS_FILE}[/dim]"
        )
        if not entries and not sessions:
            text = "Ainda não há dados. Rode uma otimização e volte aqui."
        self.query_one("#st_summary", Static).update(text)

    # -- tipo/formato --------------------------------------------------

    def fill_formats(self, entries: list[Entry]) -> None:
        table = self.query_one("#st_ext", DataTable)
        table.clear()
        groups: dict[tuple[str, str], list[Entry]] = {}
        for e in entries:
            groups.setdefault((e.kind, e.ext or "?"), []).append(e)
        rows = []
        for (kind, ext), items in groups.items():
            ok = [e for e in items if e.status == "ok"]
            orig = sum(e.orig for e in ok)
            saved = sum(saved_of(e) for e in ok)
            timed = [e.ms for e in ok if e.ms > 0]
            avg = f"{sum(timed) / len(timed) / 1000:.1f}s" if timed else "–"
            rows.append((saved, (
                "vídeo" if kind == "video" else "imagem", ext, str(len(ok)),
                str(len([e for e in items if e.status == "skip-larger"])),
                str(len([e for e in items if e.status == "efficient"])),
                human(orig), human(orig - saved), human(saved), pct(saved, orig), avg)))
        for _, row in sorted(rows, key=lambda r: r[0], reverse=True):
            table.add_row(*row)

    # -- por dia -------------------------------------------------------

    def fill_days(self, history: History) -> None:
        table = self.query_one("#st_days", DataTable)
        table.clear()
        days: dict[str, dict] = {}
        for e in history.entries:
            if e.status != "ok":
                continue
            d = days.setdefault(e.date[:10], {"n": 0, "orig": 0, "saved": 0, "sess": 0, "secs": 0})
            d["n"] += 1
            d["orig"] += e.orig
            d["saved"] += saved_of(e)
        for s in history.sessions:
            d = days.setdefault(s.end[:10], {"n": 0, "orig": 0, "saved": 0, "sess": 0, "secs": 0})
            d["sess"] += 1
            d["secs"] += s.seconds
        for day in sorted(days, reverse=True)[:90]:
            d = days[day]
            table.add_row(day, str(d["n"]), human(d["orig"]), human(d["saved"]),
                          pct(d["saved"], d["orig"]), str(d["sess"]), hms(d["secs"]))

    # -- sessões -------------------------------------------------------

    def fill_sessions(self, sessions: list[Session]) -> None:
        table = self.query_one("#st_sessions", DataTable)
        table.clear()
        for s in reversed(sessions[-300:]):
            rate = f"{human(s.orig / s.seconds * 3600)}/h" if s.seconds and s.orig else "–"
            files_h = f"{s.ok / s.seconds * 3600:.0f}" if s.seconds and s.ok else "–"
            status = {"done": Text("concluída", style="green"),
                      "canceled": Text("cancelada", style="yellow")}.get(s.status, Text(s.status))
            table.add_row(s.end.replace("T", " "), s.tool, s.mode, status, hms(s.seconds),
                          str(s.found), str(s.hist), str(s.eff), str(s.ok), str(s.skipped),
                          str(s.failed), human(s.saved), rate, files_h)

    # -- top -----------------------------------------------------------

    def fill_top(self, entries: list[Entry]) -> None:
        table = self.query_one("#st_top", DataTable)
        table.clear()
        top = sorted((e for e in entries if e.status == "ok"), key=saved_of, reverse=True)[:30]
        for e in top:
            table.add_row(human(saved_of(e)), pct(saved_of(e), e.orig), human(e.orig),
                          e.kind, e.path or "(sem caminho: registro antigo)")


