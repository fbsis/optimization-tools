class BrowserScreen(Screen):
    BINDINGS = [
        Binding("backspace,left", "up", "Subir"),
        Binding("space", "mark", "Marcar"),
        Binding("a", "mark_all", "Marcar tudo"),
        Binding("o", "optimize", "Otimizar"),
        Binding("v", "toggle_video", "Vídeos"),
        Binding("i", "toggle_image", "Imagens"),
        Binding("m", "toggle_mode", "Modo"),
        Binding("f", "toggle_force", "Forçar"),
        Binding("F", "filler", "Filler", show=False),
        Binding("r", "rescan", "Reescanear"),
        Binding("escape,q", "back", "Menu"),
    ]

    DEFAULT_CSS = """
    #path { padding: 0 1; text-style: bold; }
    #summary { padding: 0 1; color: $text-muted; }
    #options { padding: 0 1; color: $accent; }
    BrowserScreen DataTable { height: 1fr; }
    """

    def __init__(self, start: Path):
        super().__init__()
        self.cwd = start
        self.marked: set[str] = set()
        self.stats: dict[str, Stats] = {}
        self.dirs: list[str] = []
        self.gen = 0
        self.videos = True
        self.images = True
        self.copy_mode = False
        self.force = False
        self._resumed = False

    def compose(self) -> ComposeResult:
        yield Header()
        yield Static(id="path")
        yield Static(id="options")
        yield DataTable(id="table", cursor_type="row", zebra_stripes=True)
        yield Static(id="summary")
        yield Footer()

    def on_mount(self) -> None:
        table = self.query_one(DataTable)
        table.add_columns("", "Pasta", "Arquivos", "Vídeos", "Imagens", "Otimizados", "Pendente")
        self.title = "opt · otimizar mídia"
        self.load()

    def on_screen_resume(self) -> None:
        if self._resumed:
            self.rescan()
        self._resumed = True

    def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
        self.action_open()

    # -- dados ---------------------------------------------------------

    def load(self) -> None:
        self.gen += 1
        self.stats = {}
        try:
            self.dirs = sorted(
                (e.name for e in os.scandir(self.cwd)
                 if e.is_dir(follow_symlinks=False) and not e.name.startswith(".")),
                key=str.lower,
            )
        except OSError:
            self.dirs = []
        self.render_table()
        self.update_header()
        self.scan_worker(self.gen)

    def rescan(self) -> None:
        self.app.history.refresh()
        self.load()

    @work(thread=True, group="scan")
    def scan_worker(self, gen: int) -> None:
        app: OptApp = self.app  # type: ignore[assignment]
        scanner = app.scanner
        cancelled = lambda: gen != self.gen  # noqa: E731

        for name in list(self.dirs):
            if cancelled():
                return
            st = scanner.scan(str(self.cwd / name), cancel=cancelled)
            if cancelled():
                return
            self.app.call_from_thread(self.set_stats, gen, name, st)

        here = scanner.scan(str(self.cwd), recursive=False, cancel=cancelled)
        if not cancelled():
            self.app.call_from_thread(self.set_here, gen, here)

    def set_stats(self, gen: int, name: str, st: Stats) -> None:
        if gen != self.gen:
            return
        self.stats[name] = st
        self.refresh_row(name)
        self.update_summary()

    def set_here(self, gen: int, st: Stats) -> None:
        if gen != self.gen:
            return
        self.stats["."] = st
        self.update_summary()

    # -- desenho -------------------------------------------------------

    def kinds_text(self) -> str:
        parts = []
        parts.append("[b]vídeos[/b]" if self.videos else "[dim]vídeos[/dim]")
        parts.append("[b]imagens[/b]" if self.images else "[dim]imagens[/dim]")
        mode = "criar cópia" if self.copy_mode else "substituir originais"
        force = "  ·  [b]ignorar histórico[/b]" if self.force else ""
        return (f"Tipos: {' + '.join(parts)}  ·  Modo: [b]{mode}[/b]{force}"
                "  ·  [dim]Enter entra na pasta[/dim]")

    def update_header(self) -> None:
        self.query_one("#path", Static).update(f"📁 {self.cwd}")
        self.query_one("#options", Static).update(self.kinds_text())

    def row_cells(self, name: str) -> list:
        mark = Text("●", style="bold green") if str(self.cwd / name) in self.marked else Text(" ")
        st = self.stats.get(name)
        if st is None:
            return [mark, f"{name}/", "…", "…", "…", "…", "…"]

        def kind_cell(ks: KindStats) -> str:
            return f"{ks.n} · {human(ks.size)}" if ks.n else "–"

        done = (st.video.done if self.videos else 0) + (st.image.done if self.images else 0)
        total = (st.video.n if self.videos else 0) + (st.image.n if self.images else 0)
        pend_n = (st.video.pending if self.videos else 0) + (st.image.pending if self.images else 0)
        pend_b = (st.video.pend_size if self.videos else 0) + (st.image.pend_size if self.images else 0)
        pending = (
            Text(f"{pend_n} · {human(pend_b)}", style="yellow") if pend_n
            else Text("✓ nada", style="green") if total else Text("–")
        )
        return [mark, f"{name}/", str(st.files), kind_cell(st.video), kind_cell(st.image),
                f"{done}/{total}" if total else "–", pending]

    def render_table(self) -> None:
        table = self.query_one(DataTable)
        table.clear()
        if self.cwd.parent != self.cwd:
            table.add_row("", "../", "", "", "", "", "", key="..")
        for name in self.dirs:
            table.add_row(*self.row_cells(name), key=name)

    def refresh_row(self, name: str) -> None:
        table = self.query_one(DataTable)
        try:
            for col, value in zip(table.ordered_columns, self.row_cells(name)):
                table.update_cell(name, col.key, value)
        except Exception:
            pass

    def refresh_all_rows(self) -> None:
        for name in self.dirs:
            self.refresh_row(name)
        self.update_summary()

    def update_summary(self) -> None:
        total = Stats()
        for st in self.stats.values():
            total.add(st)
        scanned = len([k for k in self.stats if k != "."])
        waiting = "" if scanned >= len(self.dirs) and "." in self.stats else "  (escaneando…)"
        v, i = total.video, total.image
        text = (
            f"Total aqui: {total.files} arquivos · "
            f"vídeos {v.n} ({human(v.size)}) · imagens {i.n} ({human(i.size)})  |  "
            f"pendente: vídeos {v.pending} ({human(v.pend_size)}) · "
            f"imagens {i.pending} ({human(i.pend_size)}){waiting}"
        )
        self.query_one("#summary", Static).update(text)

    # -- ações ---------------------------------------------------------

    def current_key(self) -> str | None:
        table = self.query_one(DataTable)
        if table.row_count == 0:
            return None
        try:
            return table.coordinate_to_cell_key(table.cursor_coordinate).row_key.value
        except Exception:
            return None

    def action_open(self) -> None:
        key = self.current_key()
        if key == "..":
            self.action_up()
        elif key:
            self.cwd = self.cwd / key
            self.load()

    def action_up(self) -> None:
        if self.cwd.parent != self.cwd:
            previous = self.cwd.name
            self.cwd = self.cwd.parent
            self.load()
            table = self.query_one(DataTable)
            if previous in self.dirs:
                table.move_cursor(row=self.dirs.index(previous) + (1 if self.cwd.parent != self.cwd else 0))

    def action_mark(self) -> None:
        key = self.current_key()
        if not key or key == "..":
            return
        path = str(self.cwd / key)
        self.marked.symmetric_difference_update({path})
        self.refresh_row(key)

    def action_mark_all(self) -> None:
        paths = {str(self.cwd / n) for n in self.dirs}
        if paths <= self.marked:
            self.marked -= paths
        else:
            self.marked |= paths
        self.refresh_all_rows()

    def action_toggle_video(self) -> None:
        self.videos = not self.videos
        self.update_header()
        self.refresh_all_rows()

    def action_toggle_image(self) -> None:
        self.images = not self.images
        self.update_header()
        self.refresh_all_rows()

    def action_toggle_mode(self) -> None:
        self.copy_mode = not self.copy_mode
        self.update_header()

    def action_toggle_force(self) -> None:
        self.force = not self.force
        self.update_header()

    def action_rescan(self) -> None:
        self.rescan()

    def action_back(self) -> None:
        self.app.pop_screen()

    def action_filler(self) -> None:
        self.app.run_filler(self.cwd)

    def action_optimize(self) -> None:
        if not (self.videos or self.images):
            self.notify("Selecione vídeos e/ou imagens (v / i).", severity="warning")
            return
        paths = sorted(self.marked) or [str(self.cwd)]
        what = " + ".join(
            n for n, on in (("vídeos", self.videos), ("imagens", self.images)) if on
        )
        mode = "CRIAR CÓPIA" if self.copy_mode else "SUBSTITUIR os originais"
        listing = "\n".join(f"  • {p}" for p in paths[:8])
        if len(paths) > 8:
            listing += f"\n  … +{len(paths) - 8}"
        text = f"[b]Otimizar {what}[/b]\nModo: {mode}\n\n{listing}"

        def after(ok: bool | None) -> None:
            if ok:
                self.app.push_screen(
                    RunScreen(paths, self.videos, self.images, self.copy_mode, self.force)
                )

        self.app.push_screen(Confirm(text), after)


