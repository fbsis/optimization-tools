@dataclass
class Entry:
    fp: str
    kind: str
    status: str
    orig: int
    new: int
    date: str
    tool: str
    param: str


class History:
    def __init__(self, path: Path = HISTORY_FILE):
        self.path = path
        self._mtime: float | None = None
        self.entries: list[Entry] = []
        self.fps: set[str] = set()

    def refresh(self) -> None:
        try:
            mtime = self.path.stat().st_mtime_ns
        except OSError:
            self.entries, self.fps, self._mtime = [], set(), None
            return
        if mtime == self._mtime:
            return
        entries = []
        with open(self.path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 7:
                    continue
                parts += [""] * (8 - len(parts))
                try:
                    entries.append(
                        Entry(parts[0], parts[1], parts[2], int(parts[3] or 0),
                              int(parts[4] or 0), parts[5], parts[6], parts[7])
                    )
                except ValueError:
                    continue
        self.entries = entries
        self.fps = {e.fp for e in entries}
        self._mtime = mtime

    def has(self, fp: str) -> bool:
        return fp in self.fps


# ---------------------------------------------------------------------------
# Scanner de pastas
# ---------------------------------------------------------------------------

@dataclass
class KindStats:
    n: int = 0
    size: int = 0
    done: int = 0
    pend_size: int = 0

    @property
    def pending(self) -> int:
        return self.n - self.done

    def add(self, other: "KindStats") -> None:
        self.n += other.n
        self.size += other.size
        self.done += other.done
        self.pend_size += other.pend_size


@dataclass
class Stats:
    video: KindStats = field(default_factory=KindStats)
    image: KindStats = field(default_factory=KindStats)

    def add(self, other: "Stats") -> None:
        self.video.add(other.video)
        self.image.add(other.image)

    @property
    def files(self) -> int:
        return self.video.n + self.image.n


class Scanner:
    def __init__(self, history: History):
        self.history = history
        self._cache: dict[tuple[str, int, int], str] = {}
        self._lock = threading.Lock()

    def _fp(self, path: str, st: os.stat_result) -> str | None:
        key = (path, st.st_size, st.st_mtime_ns)
        with self._lock:
            cached = self._cache.get(key)
        if cached:
            return cached
        try:
            fp = fingerprint(path, st.st_size)
        except OSError:
            return None
        with self._lock:
            self._cache[key] = fp
        return fp

    def scan(self, root: str, recursive: bool = True, cancel=None) -> Stats:
        stats = Stats()
        stack = [root]
        while stack:
            if cancel and cancel():
                break
            current = stack.pop()
            try:
                with os.scandir(current) as it:
                    entries = list(it)
            except OSError:
                continue
            for entry in entries:
                try:
                    if entry.is_symlink():
                        continue
                    if entry.is_dir(follow_symlinks=False):
                        if recursive and not entry.name.startswith("."):
                            stack.append(entry.path)
                        continue
                    kind = kind_of(entry.name)
                    if kind is None or not entry.is_file(follow_symlinks=False):
                        continue
                    st = entry.stat(follow_symlinks=False)
                except OSError:
                    continue
                ks = stats.video if kind == "video" else stats.image
                ks.n += 1
                ks.size += st.st_size
                fp = self._fp(entry.path, st)
                if fp and self.history.has(fp):
                    ks.done += 1
                else:
                    ks.pend_size += st.st_size
        return stats


