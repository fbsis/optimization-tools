BLOCK = 65536


# ---------------------------------------------------------------------------
# Utilidades
# ---------------------------------------------------------------------------

def human(n: float) -> str:
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024 or unit == "TiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TiB"


def hms(seconds: float) -> str:
    seconds = int(seconds)
    return f"{seconds // 3600:02d}:{seconds % 3600 // 60:02d}:{seconds % 60:02d}"


def fingerprint(path: str | os.PathLike, size: int | None = None) -> str:
    """Mesma impressão digital de optlib.sh (opt_fingerprint)."""
    if size is None:
        size = os.path.getsize(path)
    with open(path, "rb") as fh:
        head = fh.read(BLOCK)
        fh.seek(size // 2 // BLOCK * BLOCK)
        mid = fh.read(BLOCK)
        fh.seek(max(0, size - BLOCK))
        tail = fh.read(BLOCK)
    return f"{size}-{hashlib.md5(head + mid + tail).hexdigest()}"


def kind_of(name: str) -> str | None:
    """'video', 'image' ou None (ignorar)."""
    if name.startswith("."):
        return None
    ext = name.rsplit(".", 1)[-1].lower() if "." in name else ""
    if ext in VIDEO_EXT:
        if name.lower().endswith("-optimized.mp4"):
            return None
        return "video"
    if ext in IMAGE_EXT:
        return "image"
    return None


def find_engine(name: str) -> str | None:
    override = os.environ.get(f"OPT_{name.upper()}")
    if override:
        return override
    here = Path(os.path.realpath(__file__)).parent / name
    if here.is_file() and os.access(here, os.X_OK):
        return str(here)
    return shutil.which(name)


