def _int(value: str) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


class History:
    def __init__(self, path: Path = HISTORY_FILE):
        self.path = path
        self._mtime: float | None = None
        self.entries: list[Entry] = []
        self.fps: set[str] = set()
        self.sessions: list[Session] = []
        self._smtime: float | None = None

    def refresh_sessions(self) -> None:
        try:
            mtime = SESSIONS_FILE.stat().st_mtime_ns
        except OSError:
            self.sessions, self._smtime = [], None
            return
        if mtime == self._smtime:
            return
        out = []
        with open(SESSIONS_FILE, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                p = line.rstrip("\n").split("\t")
                if len(p) < 16:
                    continue
                p += [""] * (17 - len(p))
                out.append(Session(
                    p[0], p[1], p[2], p[3], p[4],
                    _int(p[5]), _int(p[6]), _int(p[7]), _int(p[8]), _int(p[9]),
                    _int(p[10]), _int(p[11]), _int(p[12]), _int(p[13]),
                    _int(p[14]), _int(p[15]), p[16],
                ))
        self.sessions = out
        self._smtime = mtime

    def refresh(self) -> None:
        self.refresh_sessions()
        try:
            mtime = self.path.stat().st_mtime_ns
        except OSError:
            self.entries, self.fps, self._mtime = [], set(), None
            return
        if mtime == self._mtime:
            return
        entries = []
        with open(self.path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 7:
                    continue
                parts += [""] * (12 - len(parts))
                entries.append(
                    Entry(parts[0], parts[1], parts[2], _int(parts[3]), _int(parts[4]),
                          parts[5], parts[6], parts[7], parts[8], _int(parts[9]),
                          parts[10], parts[11])
                )
        self.entries = entries
        self.fps = {e.fp for e in entries}
        self._mtime = mtime

    def has(self, fp: str) -> bool:
        return fp in self.fps


