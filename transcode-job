#!/usr/bin/env bash

set -uo pipefail

INPUT="${1:?Informe o arquivo de entrada}"
OUTPUT="${2:?Informe o arquivo de saída}"

DEVICE="/dev/dri/renderD128"
QP="${QP:-23}"

if [[ ! -f "$INPUT" ]]; then
    echo "Arquivo não encontrado: $INPUT"
    exit 1
fi

# Executa o ffmpeg com o caminho de decodificação escolhido:
#   hw -> decode VAAPI (iGPU) + encode VAAPI
#   sw -> decode em software       + encode VAAPI
# Os argumentos extras (log/progresso) vêm de "$@".
run_ffmpeg() {
    local decode="$1"
    shift

    local -a dec=() vf=()

    if [[ "$decode" == "hw" ]]; then
        dec=(-hwaccel vaapi -hwaccel_output_format vaapi)
        vf=(scale_vaapi=format=nv12)
    else
        vf=(format=nv12,hwupload)
    fi

    ffmpeg \
        -hide_banner \
        "$@" \
        "${dec[@]}" \
        -vaapi_device "$DEVICE" \
        -i "$INPUT" \
        -map 0:v:0 \
        -map 0:a? \
        -map_metadata 0 \
        -vf "${vf[*]}" \
        -c:v h264_vaapi \
        -profile:v high \
        -qp "$QP" \
        -c:a aac \
        -b:a 128k \
        -movflags +faststart \
        -y \
        "$OUTPUT"
}

# Tudo por hardware (decode + encode na iGPU). Se o iGPU não suportar o codec
# de entrada, cai automaticamente para decodificação em software.
encode() {
    if run_ffmpeg hw "$@"; then
        return 0
    fi

    echo "Aviso: decodificação por hardware falhou; usando software." >&2
    rm -f "$OUTPUT"
    run_ffmpeg sw "$@"
}

if [[ "${MACHINE:-0}" == "1" ]]; then
    # Modo máquina: só imprime "PCT <n>" (usado pela TUI via videoopt --events).
    DURATION="$(
        ffprobe -v error \
            -show_entries format=duration \
            -of default=nw=1:nk=1 \
            "$INPUT" 2>/dev/null || echo 0
    )"

    encode -nostats -loglevel error -progress pipe:1 |
    awk -F= -v dur="$DURATION" '
        $1 == "out_time_us" && dur + 0 > 0 {
            pct = int(($2 / 1000000) * 100 / dur)
            if (pct > 100) pct = 100
            if (pct != last && pct >= 0) {
                print "PCT " pct
                fflush()
                last = pct
            }
        }
    '

    exit "${PIPESTATUS[0]}"
fi

echo "=========================================="
echo "TRANSCODER INTEL GPU"
echo "=========================================="
echo "Entrada: $INPUT"
echo "Saída:   $OUTPUT"
echo "GPU:     $DEVICE"
echo "Decode:  VAAPI (hardware; fallback software)"
echo "Codec:   H.264 VAAPI"
echo "QP:      $QP"
echo "=========================================="

encode -stats

echo
echo "Concluído:"
du -h "$INPUT" "$OUTPUT"
