#!/usr/bin/env bash

set -euo pipefail

show_help() {
    cat <<'EOF'

OPT - Central de otimização

Uso:

  opt
      Abre a interface TUI (se o Python/Textual estiver instalado)
      ou o menu de texto clássico.

  opt --classic
      Força o menu de texto clássico.

  opt history
      Mostra o resumo do histórico de otimizações.

  opt stats
      Estatísticas: otimizados, sem ganho, economia por tipo/formato,
      por dia e por sessão (tempo e vazão).

  opt video [arquivo]
      Executa o videoopt.
      Sem arquivo: processa os vídeos da pasta atual.
      Com arquivo: processa somente o vídeo informado.

  opt image [pasta ...]
  opt imagem
      Executa o imgopt na pasta atual (ou nas pastas informadas).

  opt filler
      Move arquivos da pasta atual para o volume VeraCrypt.

  opt extract [pasta]
  opt extrair
  opt descompactar
      Descompacta um arquivo .rar/.zip/.7z da pasta atual (e os
      compactados que houver dentro dele), com painel de progresso.
      Só roda se o arquivo estiver em um filesystem local.

Exemplos:

  opt video "video.mp4"
  opt video
  opt image
  opt imagem
  opt extract
  opt filler

EOF
}

run_video() {
    shift || true
    exec videoopt "$@"
}

run_image() {
    shift || true
    exec imgopt "$@"
}

run_history() {
    local file="${OPT_HISTORY:-${OPT_DATA_DIR:-$HOME/.local/share/opt}/history.tsv}"

    if [[ ! -s "$file" ]]; then
        echo "Histórico vazio ($file)"
        exit 0
    fi

    awk -F'\t' '
        { total++; st[$3]++; kind[$2]++ }
        $3 == "ok" { saved += $4 - $5 }
        END {
            printf "Registros:   %d\n", total
            printf "Otimizados:  %d\n", st["ok"]
            printf "Sem ganho:   %d\n", st["skip-larger"]
            printf "Eficientes:  %d\n", st["efficient"]
            printf "Vídeos:      %d\n", kind["video"]
            printf "Imagens:     %d\n", kind["image"]
            printf "Economia:    %.2f GiB\n", saved / 1073741824
        }
    ' "$file"

    echo
    echo "Arquivo: $file"
    exit 0
}

# OPT_PYTHON permite apontar para um venv onde o textual esteja instalado.
OPT_PYTHON="${OPT_PYTHON:-python3}"

run_stats() {
    local dir="${OPT_DATA_DIR:-$HOME/.local/share/opt}"
    local history="${OPT_HISTORY:-$dir/history.tsv}"
    local sessions="${OPT_SESSIONS:-$dir/sessions.tsv}"

    if [[ ! -s "$history" && ! -s "$sessions" ]]; then
        echo "Ainda não há dados. Rode uma otimização primeiro."
        exit 0
    fi

    if [[ -s "$history" ]]; then
        awk -F'\t' '
            function gib(b) { return sprintf("%.2f GiB", b / 1073741824) }
            function pc(a, b) { return b > 0 ? sprintf("%.0f%%", a * 100 / b) : "-" }
            { n++; st[$3]++ }
            $3 == "ok" {
                saved = $4 - $5
                orig += $4; new += $5; tot += saved
                k = $2; ko[k]++; kor[k] += $4; ks[k] += saved
                e = ($9 == "" ? "?" : $9); key = k " " e
                eo[key]++; es[key] += saved; eor[key] += $4
                d = substr($6, 1, 10); dn[d]++; ds[d] += saved
                if ($10 > 0) { ms[k] += $10; mc[k]++ }
            }
            END {
                printf "== Arquivos ==\n"
                printf "Registrados:   %d\n", n
                printf "Otimizados:    %d (sucesso %s)\n", st["ok"], pc(st["ok"], st["ok"] + st["skip-larger"])
                printf "Sem ganho:     %d\n", st["skip-larger"]
                printf "Já eficientes: %d\n\n", st["efficient"]
                printf "== Espaço ==\n"
                printf "Original -> novo: %s -> %s\n", gib(orig), gib(new)
                printf "Economia total:   %s (%s)\n", gib(tot), pc(tot, orig)
                if (st["ok"] > 0) printf "Média/arquivo:    %.1f MiB\n", tot / st["ok"] / 1048576
                printf "\n== Por tipo ==\n"
                for (k in ko) {
                    printf "%-7s %6d otimizados  economia %s (%s)", k, ko[k], gib(ks[k]), pc(ks[k], kor[k])
                    if (mc[k] > 0) printf "  tempo médio %.1fs", ms[k] / mc[k] / 1000
                    printf "\n"
                }
                printf "\n== Por formato ==\n"
                for (x in eo) printf "%-12s %6d  economia %s (%s)\n", x, eo[x], gib(es[x]), pc(es[x], eor[x])
                printf "\n== Últimos dias ==\n"
                for (d in dn) printf "%s %5d arquivos  %s\n", d, dn[d], gib(ds[d])
            }
        ' "$history"
    fi

    if [[ -s "$sessions" ]]; then
        echo
        echo "== Sessões =="

        awk -F'\t' '
            function hms(s) { return sprintf("%02d:%02d:%02d", s / 3600, (s % 3600) / 60, s % 60) }
            { n++; secs += $14; proc += $11; ok += $8; fail += $10; if ($5 == "canceled") canc++
              last[n] = sprintf("%s  %-8s %-9s %s  ok %d  ign %d  err %d  economia %.2f GiB", \
                  $2, $3, $5, hms($14), $8, $9, $10, $13 / 1073741824) }
            END {
                printf "Execuções:   %d (%d canceladas)\n", n, canc
                printf "Tempo total: %s (média %s)\n", hms(secs), hms(n ? secs / n : 0)
                if (secs > 0) printf "Vazão média: %.2f GiB/h · %.0f arquivos/h\n", proc / secs * 3600 / 1073741824, ok / secs * 3600
                printf "Erros:       %d\n\nÚltimas sessões:\n", fail
                for (i = (n > 5 ? n - 4 : 1); i <= n; i++) print "  " last[i]
            }
        ' "$sessions"
    fi

    exit 0
}

tui_available() {
    command -v opt-tui >/dev/null 2>&1 &&
        "$OPT_PYTHON" -c 'import textual' >/dev/null 2>&1
}

run_tui() {
    exec "$OPT_PYTHON" "$(command -v opt-tui)" "$@"
}

run_filler() {
    exec filler
}

# Caminho do descompactador (extract.sh, com painel visual).
extract_engine() {
    local c
    for c in \
        "${OPT_EXTRACT:-}" \
        "/usr/local/bin/extract.sh" \
        "$(dirname "$(command -v opt 2>/dev/null || echo /usr/local/bin/opt)")/extract.sh" \
        "$HOME/extract.sh"
    do
        [[ -n "$c" && -x "$c" ]] && { printf '%s\n' "$c"; return 0; }
    done
    return 1
}

# Descompacta um arquivo da pasta atual (só se ele estiver num FS local).
run_extract() {
    shift || true

    local dir="${1:-$PWD}"
    local -a files=()
    local f i n c fstype eng sel

    shopt -s nullglob nocaseglob
    for f in "$dir"/*.rar "$dir"/*.zip "$dir"/*.7z; do
        files+=("$f")
    done
    shopt -u nullglob nocaseglob

    if (( ${#files[@]} == 0 )); then
        echo "Nenhum arquivo .rar/.zip/.7z em: $dir"
        return 0
    fi

    echo
    echo "Arquivos compactados em $dir:"
    i=1
    for f in "${files[@]}"; do
        printf '  [%d] %-45s %s\n' "$i" "$(basename "$f")" "$(du -h "$f" 2>/dev/null | cut -f1)"
        (( i++ ))
    done
    echo

    read -r -p "Qual extrair? (número; Enter cancela): " n
    [[ "$n" =~ ^[0-9]+$ ]] || { echo "Cancelado."; return 0; }
    (( n >= 1 && n <= ${#files[@]} )) || { echo "Número inválido."; return 1; }

    sel="${files[$((n-1))]}"

    # só executa a extração se o arquivo estiver num sistema de arquivos LOCAL
    fstype="$(stat -f -c %T "$sel" 2>/dev/null || echo desconhecido)"
    case "$fstype" in
        ext2/ext3|ext4|xfs|btrfs|zfs|overlay|tmpfs) ;;   # local: ok
        *)
            echo
            echo "⚠ '$fstype' não é um sistema de arquivos local (rede/fuse)."
            read -r -p "Continuar mesmo assim? [s/N]: " c
            [[ "${c,,}" == s* ]] || { echo "Cancelado."; return 1; }
            ;;
    esac

    if ! eng="$(extract_engine)"; then
        echo "ERRO: extract.sh não encontrado."
        echo "Instale-o em /usr/local/bin/extract.sh ou defina OPT_EXTRACT."
        return 1
    fi

    exec "$eng" "$sel"
}

if [[ $# -gt 0 ]]; then
    case "${1,,}" in
        --classic|classic)
            ;;

        tui)
            if tui_available; then
                shift
                run_tui "$@"
            fi

            echo "TUI indisponível. Instale: pipx install textual (ou pip install textual)"
            exit 1
            ;;

        history|historico|histórico)
            run_history
            ;;

        stats|estatisticas|estatísticas)
            run_stats
            ;;

        video|videos)
            run_video "$@"
            ;;

        image|imagem|images|imagens)
            run_image "$@"
            ;;

        filler|fill|veracrypt)
            run_filler
            ;;

        extract|extrair|descompactar|unzip)
            run_extract "$@"
            ;;

        help|-h|--help|ajuda)
            show_help
            exit 0
            ;;

        *)
            echo "Comando desconhecido: $1"
            show_help
            exit 1
            ;;
    esac
fi

if [[ "${1:-}" != "--classic" && "${1:-}" != "classic" ]] && tui_available; then
    run_tui
fi

clear

echo "=========================================="
echo "                 OPT"
echo "=========================================="
echo
echo "Ferramentas disponíveis:"
echo
echo "  [1] VIDEO"
echo "      Otimiza vídeos usando o LXC transcoder"
echo "      e a GPU Intel."
echo
echo "  [2] IMAGE"
echo "      Otimiza JPG, PNG e WEBP da pasta atual"
echo "      usando processamento paralelo."
echo
echo "  [3] EXTRAIR"
echo "      Descompacta um arquivo .rar/.zip/.7z da pasta"
echo "      atual (e os compactados internos), com painel"
echo "      de progresso. Só roda se o arquivo for local."
echo
echo "  [4] FILLER"
echo "      Move arquivos da pasta atual para o"
echo "      volume VeraCrypt até ele ficar cheio."
echo
echo "  [5] AJUDA"
echo
echo "  [0] SAIR"
echo

while true; do
    read -r -p "Escolha [0-5]: " OPTION

    case "$OPTION" in
        1)
            exec videoopt
            ;;

        2)
            exec imgopt
            ;;

        3)
            run_extract
            ;;

        4)
            exec filler
            ;;

        5)
            show_help
            exit 0
            ;;

        0)
            exit 0
            ;;

        *)
            echo "Escolha entre 0 e 5."
            ;;
    esac
done